{
  "name": "ng-tel-input-workspace",
  "version": "0.0.0",
  "scripts": {
    "build": "ng build ng-tel-input && node scripts/strip-tslib.mjs",
    "size": "node scripts/size.mjs",
    "test": "ng test --watch=false",
    "pack": "npm run build && cd dist/ng-tel-input && npm pack",
    "release": "npm test && npm run build && cd dist/ng-tel-input && npm publish --access public",
    "demo": "ng serve demo",
    "demo:build": "ng build demo"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cdk": "^22.2.5",
    "@angular/cli": "^22.0.8",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/material": "^22.2.5",
    "@angular/platform-browser": "^22.2.4",
    "esbuild": "0.28.2",
    "jsdom": "^30.0.0",
    "libphonenumber-js": "^1.12.0",
    "ng-packagr": "^22.2.0",
    "prettier": "^3.8.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
